{
  "name": "abror-harness",
  "version": "0.2.0",
  "description": "Abror Harness — beautiful modular AI agent framework. Event-driven, plugin-based, with modern web UI.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "abror": "dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "cd web && npm run dev -- --host",
    "build": "tsc && cd web && npm run build",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "setup": "npm install && cd web && npm install"
  },
  "keywords": ["ai-agent", "agent-framework", "event-driven", "plugin", "llm", "deepseek", "typescript", "react"],
  "author": "Abror",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^4.73.0",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
